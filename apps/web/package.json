{
  "name": "@twofold/web",
  "version": "0.1.0",
  "private": true,
  "description": "Twofold Web Alpha client built with TanStack Start and Vite",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "routes:generate": "tsr generate",
    "test": "vitest run",
    "typecheck": "pnpm routes:generate && tsc --noEmit",
    "check": "pnpm test && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "@twofold/game-core": "workspace:*",
    "@twofold/shared-types": "workspace:*",
    "@xstate/react": "^6.1.0",
    "clsx": "^2.1.1",
    "crossws": "0.4.12",
    "lucide-react": "^0.439.0",
    "nitro": "3.0.260610-beta",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "srvx": "0.11.22",
    "tailwind-merge": "^2.5.2",
    "xstate": "^5.32.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.167.33",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  }
}
